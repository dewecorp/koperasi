# ============================================================
# Koperasi Sekolah - public/.htaccess
# Berlaku bila docroot diarahkan ke folder public.
# ============================================================
RewriteEngine On

# 1) Hilangkan index.php dari URL (301)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L,QSA]

# 2) Hilangkan ekstensi .php dari URL (301), kecuali index.php (sudah di atas)
RewriteCond %{THE_REQUEST} !index\.php [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?([^.]+)\.php[\s?] [NC]
RewriteRule ^(.*/)?([^.]+)\.php$ /$1$2 [R=301,L,QSA]

# 3) Request yang bukan file/folder asli diteruskan ke index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]